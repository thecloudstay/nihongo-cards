[[".wk{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%) scale(.96);z-index:71;\n  width:min(360px,100% - 28px);background:var(--card);border-radius:22px;padding:14px 14px 12px;\n  box-shadow:0 18px 50px rgba(0,0,0,.22);opacity:0;pointer-events:none;transition:opacity .18s,transform .18s}", ".wk{position:fixed;left:50%;top:50%;transform:translate(-50%,-50%) scale(.96);z-index:71;\n  width:min(360px,100% - 28px);max-height:94vh;overflow:auto;background:var(--card);border-radius:22px;padding:14px 14px 12px;\n  box-shadow:0 18px 50px rgba(0,0,0,.22);opacity:0;pointer-events:none;transition:opacity .18s,transform .18s}"], ["  font-size:18px;color:var(--sub);cursor:pointer;flex:none}\n.wk-box{position:relative;width:100%;aspect-ratio:1/1;border-radius:16px;background:var(--bg);\n  border:2px solid var(--line);overflow:hidden;touch-action:none}", "  font-size:18px;color:var(--sub);cursor:pointer;flex:none}\n/* 화면이 짧으면 쓰는 칸이 먼저 줄어든다 — 버튼이 잘려서 못 누르는 일이 없게 */\n.wk-box{position:relative;width:min(100%,52vh);margin:0 auto;aspect-ratio:1/1;border-radius:16px;background:var(--bg);\n  border:2px solid var(--line);overflow:hidden;touch-action:none}"]]